# Exemplo de ambiente do arenabruta. SÓ NOMES: os valores ficam no Infisical (rt-produtos/arenabruta, ambiente prod) e chegam à VPS no deploy. Nunca commitar valores.
# Em desenvolvimento local basta copiar para .env e preencher o que for usar; sem SMTP/LLM o app roda em modo de desenvolvimento.

ARENA_ADMIN_KEY=
ARENA_DEMO_SENHA=
ARENA_LLM_KEY=
ARENA_PIX_CHAVE=
ARENA_SEGREDO_SESSAO=
ARENA_SMTP_FROM=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
